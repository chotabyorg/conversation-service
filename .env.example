# Local isolated development only. Provision private credentials in untracked .env.
# DATABASE_PASSWORD is consumed by docker-compose only. Replace every placeholder.
DATABASE_PASSWORD=replace-with-random-local-password
DATABASE_URL=postgresql+asyncpg://conversation:replace-with-random-local-password@127.0.0.1:55595/conversation
CONVERSATION_AUTH_PRINCIPALS=[{"principal_id":"local-worker","token":"replace-with-random-dedicated-token-at-least-32-characters","grants":[{"owner_id":"local-owner","integration_id":"00000000-0000-4000-8000-000000000001","channel":"WEBSITE_WIDGET","provider_namespace":"local.widget"}]}]
LOG_LEVEL=INFO

# Optional unconsumed managed harness. Omit keys to leave execution unconfigured.
# MANAGED_AI_BINDINGS=[{"owner_id":"local-owner","integration_id":"00000000-0000-4000-8000-000000000001","channel":"WEBSITE_WIDGET","agent_id":"00000000-0000-4000-8000-000000000002","service_token":"replace-with-independent-random-local-token"}]
# MANAGED_AI_BASE_URL=http://127.0.0.1:55570
# MANAGED_AI_CONNECT_SECONDS=5
# MANAGED_AI_WRITE_SECONDS=10
# MANAGED_AI_READ_SECONDS=100
# MANAGED_AI_POOL_SECONDS=5
# MANAGED_AI_TOTAL_SECONDS=120

# Goal4A source defaults are dark. Use dedicated exact private grants before enabling.
WEBSITE_BINDINGS=[]
WEBSITE_WORKER_ENABLED=false
# WEBSITE_WORKER_PRINCIPAL_ID=local-processing-worker
WEBSITE_WORKER_LEASE_SECONDS=30
WEBSITE_WORKER_POLL_SECONDS=1.0
WEBSITE_WORKER_HEALTH_PORT=8001

# Goal4B Telegram defaults are dark. Preserve Telegram bindings after rollback
# so previously accepted managed admissions can still be replayed.
TELEGRAM_CANARY_INTEGRATION_IDS=[]
TELEGRAM_WORKER_ENABLED=false
# TELEGRAM_WORKER_PRINCIPAL_ID=local-telegram-worker
TELEGRAM_WORKER_LEASE_SECONDS=30
TELEGRAM_WORKER_POLL_SECONDS=1.0
TELEGRAM_WORKER_HEALTH_PORT=8002
# Example exact binding/grants (use independent random tokens):
# MANAGED_AI_BINDINGS=[{"owner_id":"local-owner","integration_id":"00000000-0000-4000-8000-000000000003","channel":"TELEGRAM","agent_id":"00000000-0000-4000-8000-000000000004","service_token":"replace-with-independent-random-local-token"}]
# CONVERSATION_AUTH_PRINCIPALS=[{"principal_id":"local-telegram-gateway","role":"TELEGRAM","token":"replace-with-independent-random-token-32-characters","grants":[{"owner_id":"local-owner","integration_id":"00000000-0000-4000-8000-000000000003","channel":"TELEGRAM","provider_namespace":"main-chota.telegram.v1"}]},{"principal_id":"local-telegram-worker","role":"TELEGRAM_PROCESSING","token":"replace-with-independent-random-worker-token-32chars","grants":[{"owner_id":"local-owner","integration_id":"00000000-0000-4000-8000-000000000003","channel":"TELEGRAM","provider_namespace":"main-chota.telegram.v1"}]}]

# Goal5 settling is opt-in. Omit policies to keep immediate one-message selection.
# A channel policy may be overridden by one integration-specific policy.
# TURN_SETTLING_POLICIES=[{"version":"telegram-v1","channel":"TELEGRAM","quiet_window_ms":800,"max_wait_ms":5000},{"version":"telegram-fast-v1","channel":"TELEGRAM","integration_id":"00000000-0000-4000-8000-000000000003","quiet_window_ms":300,"max_wait_ms":2000}]
